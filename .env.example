# Required. Any long random value; shared with reviewers out of band.
API_BEARER_TOKEN=replace-with-a-long-random-value

# Required. https://openrouter.ai/keys
OPENROUTER_API_KEY=replace-me

# Embeddings. Requested at 2048 dimensions to match the halfvec column.
EMBEDDING_MODEL=openai/text-embedding-3-large

# Summaries. Any OpenAI-compatible chat-completions endpoint.
# Pinned to a specific model on purpose: the `openrouter/free` router picks an
# arbitrary free model per call, including reasoning and content-safety models
# that return an empty message. Free NVIDIA endpoints measured 30% overloaded.
# Defaults to OpenRouter using OPENROUTER_API_KEY when left blank.
SUMMARY_BASE_URL=
SUMMARY_API_KEY=
SUMMARY_MODEL=google/gemini-2.5-flash-lite

# To use DeepSeek directly for summaries instead:
#   SUMMARY_BASE_URL=https://api.deepseek.com
#   SUMMARY_API_KEY=your-deepseek-key
#   SUMMARY_MODEL=deepseek-chat
